std::vector<uint8_t> NES::createTestProgram()
    {
        std::vector<uint8_t> program(0x8000, 0x00);

        // ==========================================
        // 1. TEST DCP ($CF): DEC memoria + CMP A
        // Target $0210 = 0x05, A = 0x04
        // - DEC $0210 (0x05 - 1) -> $0210 pasa a 0x04
        // - CMP A con 0x04 (0x04 - 0x04):
        //   -> Z=1 (son iguales)
        //   -> C=1 (A >= Memoria)
        //   -> N=0
        // ==========================================
        program[0x0000] = 0xA9; program[0x0001] = 0x05; // $8000: LDA #$05
        program[0x0002] = 0x8D; program[0x0003] = 0x10; program[0x0004] = 0x02; // $8002: STA $0210
        program[0x0005] = 0xA9; program[0x0006] = 0x04; // $8005: LDA #$04

        // $8007: DCP $0210 (Opcode 0xCF - DCP Absoluto)
        program[0x0007] = 0xCF; program[0x0008] = 0x10; program[0x0009] = 0x02;

        // Guarda A y Banderas del Test 1 (DCP)
        program[0x000A] = 0x8D; program[0x000B] = 0x00; program[0x000C] = 0x02; // $800A: STA $0200 (A sigue siendo 0x04)
        program[0x000D] = 0x08; // $800D: PHP
        program[0x000E] = 0x68; // $800E: PLA
        program[0x000F] = 0x8D; program[0x0010] = 0x01; program[0x0011] = 0x02; // $800F: STA $0201 (Banderas tras DCP)

        // ==========================================
        // 2. TEST ISB / ISC ($EF): INC memoria + SBC A
        // Target $0211 = 0x01, A = 0x10, Carry = 1 (sin borrow previo)
        // - INC $0211 (0x01 + 1) -> $0211 pasa a 0x02
        // - SBC A (0x10 - 0x02 - (1 - C)) con C=1:
        //   -> 0x10 - 0x02 = 0x0E
        //   -> A pasa a 0x0E (Z=0, N=0, C=1, V=0)
        // ==========================================
        program[0x0012] = 0x38; // $8012: SEC         (Garantiza C=1 para SBC)
        program[0x0013] = 0xA9; program[0x0014] = 0x01; // $8013: LDA #$01
        program[0x0015] = 0x8D; program[0x0016] = 0x11; program[0x0017] = 0x02; // $8015: STA $0211
        program[0x0018] = 0xA9; program[0x0019] = 0x10; // $8018: LDA #$10

        // $801A: ISB $0211 (Opcode 0xEF - ISB Absoluto)
        program[0x001A] = 0xEF; program[0x001B] = 0x11; program[0x001C] = 0x02;

        // Guarda A y Banderas del Test 2 (ISB)
        program[0x001D] = 0x8D; program[0x001E] = 0x02; program[0x001F] = 0x02; // $801D: STA $0202 (A = 0x0E)
        program[0x0020] = 0x08; // $8020: PHP
        program[0x0021] = 0x68; // $8021: PLA
        program[0x0022] = 0x8D; program[0x0023] = 0x03; program[0x0024] = 0x02; // $8022: STA $0203 (Banderas tras ISB)

        // ==========================================
        // FIN DEL PROGRAMA
        // ==========================================
        program[0x0025] = 0x02; // $8025: KIL

        // Vectores de Reset ($FFFC/$FFFD)
        program[0x7FFC] = 0x00;
        program[0x7FFD] = 0x80;

        return program;

    }

SALIDA
$2000 = 0x04
$2001 = 0x37
$2002 = 0x0E
$2003 = 0x35

$2010 = 0x04
$2011 = 0x02