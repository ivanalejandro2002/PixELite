std::vector<uint8_t> NES::createTestProgram()
    {
        std::vector<uint8_t> program(0x8000, 0x00);

        // $8000: LDA #$42
        program[0x0000] = 0xA9;
        program[0x0001] = 0x42;

        // ADC #$77
        program[0x0002] = 0x69;
        program[0x0003] = 0x77;

        // STA #$0x31
        program[0x0004] = 0x85;
        program[0x0005] = 0x31;

        //KILL
        program[0x0006] = 0xB2;

        // Reset vector: $FFFC/$FFFD -> $8000
        program[0x7FFC] = 0x00;
        program[0x7FFD] = 0x80;

        return program;
    }