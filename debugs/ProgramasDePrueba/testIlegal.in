std::vector<uint8_t> NES::createTestProgram()
    {
        std::vector<uint8_t> program(0x8000, 0x00);

        // ==========================================
        // 1. TEST RLA ($2F): ROL memoria + AND A
        // Target $0210 = 0x80, A = 0xFF, Carry = 1
        // - ROL $0210 (0x80 con C=1) -> $0210 pasa a 0x01, Carry saliente C=1
        // - AND A (0xFF & 0x01)      -> A pasa a 0x01 (Z=0, N=0)
        // ==========================================
        program[0x0000] = 0x38; // $8000: SEC         (Carry = 1)
        program[0x0001] = 0xA9; program[0x0002] = 0x80; // $8001: LDA #$80
        program[0x0003] = 0x8D; program[0x0004] = 0x10; program[0x0005] = 0x02; // $8003: STA $0210
        program[0x0006] = 0xA9; program[0x0007] = 0xFF; // $8006: LDA #$FF

        // $8008: RLA $0210 (Opcode 0x2F - RLA Absoluto)
        program[0x0008] = 0x2F; program[0x0009] = 0x10; program[0x000A] = 0x02;

        // Guarda A y Memoria del Test 1
        program[0x000B] = 0x8D; program[0x000C] = 0x00; program[0x000D] = 0x02; // $800B: STA $0200 (A = 0x01)

        // ==========================================
        // 2. TEST SRE ($4F): LSR memoria + EOR A
        // Target $0211 = 0x03, A = 0x0F
        // - LSR $0211 (0x03 >> 1) -> $0211 pasa a 0x01, Carry saliente C=1
        // - EOR A (0x0F ^ 0x01)   -> A pasa a 0x0E (Z=0, N=0)
        // ==========================================
        program[0x000E] = 0xA9; program[0x000F] = 0x03; // $800E: LDA #$03
        program[0x0010] = 0x8D; program[0x0011] = 0x11; program[0x0012] = 0x02; // $8010: STA $0211
        program[0x0013] = 0xA9; program[0x0014] = 0x0F; // $8013: LDA #$0F

        // $8015: SRE $0211 (Opcode 0x4F - SRE Absoluto)
        program[0x0015] = 0x4F; program[0x0016] = 0x11; program[0x0017] = 0x02;

        // Guarda A del Test 2
        program[0x0018] = 0x8D; program[0x0019] = 0x01; program[0x001A] = 0x02; // $8018: STA $0201 (A = 0x0E)

        // ==========================================
        // 3. TEST RRA ($6F): ROR memoria + ADC A
        // Target $0212 = 0x01, A = 0x05 (Del test anterior viene C=1)
        // - ROR $0212 (0x01 >> 1 con C=1) -> $0212 pasa a 0x80, Carry saliente C=1
        // - ADC A (0x05 + 0x80 + C=1)     -> A pasa a 0x86 (N=1, V=0, C=0)
        // ==========================================
        program[0x001B] = 0xA9; program[0x001C] = 0x01; // $801B: LDA #$01
        program[0x001D] = 0x8D; program[0x001E] = 0x12; program[0x001F] = 0x02; // $801D: STA $0212
        program[0x0020] = 0xA9; program[0x0021] = 0x05; // $8020: LDA #$05

        // $8022: RRA $0212 (Opcode 0x6F - RRA Absoluto)
        program[0x0022] = 0x6F; program[0x0023] = 0x12; program[0x0024] = 0x02;

        // Guarda A del Test 3
        program[0x0025] = 0x8D; program[0x0026] = 0x02; program[0x0027] = 0x02; // $8025: STA $0202 (A = 0x86)

        // Guarda las banderas P resultantes de la suma RRA
        program[0x0028] = 0x08; // $8028: PHP
        program[0x0029] = 0x68; // $8029: PLA
        program[0x002A] = 0x8D; program[0x002B] = 0x03; program[0x002C] = 0x02; // $802A: STA $0203

        // ==========================================
        // FIN DEL PROGRAMA
        // ==========================================
        program[0x002D] = 0x02; // $802D: KIL

        // Vectores de Reset
        program[0x7FFC] = 0x00;
        program[0x7FFD] = 0x80;

        return program;

    }

Salida
$2000 = 0x01
$2001 = 0x0E
$2002 = 0x86
$2003 = 0xB4

$2010 = 0x01
$2011 = 0x01
$2012 = 0x80